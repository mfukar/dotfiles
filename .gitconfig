[user]
    name = Michael Foukarakis
    email = michael.foukarakis@bmw.de
    signingkey = /Users/Q411399/.ssh/id_ed25519_commitsigning.pub
[gui]
[color]
    diff = auto
    status = auto
    branch = auto
[core]
    pager = less
    editor = vim
[core "whitespace"]
    tabwidth = 4
[diff]
    tool = vimdiff
[alias]
    history = log --color --graph --pretty=format:'%Cred%h%Creset | %s %Cgreen(%cr)%Creset [%C(bold blue)%an%Creset]'
    find = log --pretty='format:%Cgreen%H %Cblue%s%Creset' --name-status --grep
    slog = log --color --pretty=format:'%C(yellow)%h%Creset | %<(72)%s %Cgreen(%ci)%Creset'
    cdif = diff --word-diff=color
    subupdate = submodule update --init --recursive
    ifix = !sh -c '_git_commit_HEAD=$(git rev-parse HEAD) && git commit -p --fixup="$_git_commit_HEAD" && unset _git_commit_HEAD'
[push]
    default = matching
[gc]
    auto = 256
[pull]
    rebase = true
[gitreview]
    remote = origin
[merge]
    tool = vimdiff
    conflictstyle = diff3
[apply]
    ignoreWhitespace = change
[mergetool]
    prompt = false
[credential]
    helper = osxkeychain
[clean]
    requireForce = false
[remote "origin"]
	prune = true
