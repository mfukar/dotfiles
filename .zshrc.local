export PATH="${PATH}:${HOME}/src/openmpi-installation/bin:/usr/local/opt/llvm/bin"

alias unlock='cat ~/.ssh/chameleon-luks.pass | ssh -T chameleon-unlock'

# Show the different protocols in all pcap files in a directory using tshark
pcap-protos () {
    c0="\033[0m"
    c1="\033[38;5;226m"
    bg="\033[48;5;102m"
    for file in "${1}"/*.pcap
    do
        if [ "$file" != $0 ] ; then
            echo -e "${c1}${bg}${file}"
            /Users/q411399/Applications/Wireshark.app/Contents/MacOS/tshark -r "$file" -T fields -e frame.protocols | sort -u
            echo -e "${c0}"
        fi
    done
}


# eynchronise the date with a remote client using SSH:
sync-date() {
    if [ "$#" -ne 2 ]; then echo "Usage: sync-date <host> <interval>"; fi
    while [ true ]; do
        ssh $1 "date -s \"@$( date +%s )\"" && echo "Date set.";
        sleep $2;
    done
}

# Open yazi on CWD
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
}

# Build a specific docker image with a given or pre-defined name format:
docker_buildimage() {
    if [ $# -ne 1 ]; then
        echo "DOCKER_BUILDKIT=1 docker build --secret id=netrc,src=${HOME}/.netrc -t common.artifactory.cc.bmwgroup.net/node0-lsmf-docker/lsmf-ci-image:$(date +%y)w$(date +%V).$(date +%w) ."
    else
        echo "DOCKER_BUILDKIT=1 docker build --secret id=netrc,src=${HOME}/.netrc -t common.artifactory.cc.bmwgroup.net/node0-lsmf-docker/lsmf-ci-image:${1} ."
    fi
}

# zplug config
source ~/.zplug/init.zsh
